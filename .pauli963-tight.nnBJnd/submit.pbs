#!/bin/bash
#PBS -P Entropy
#PBS -q parallel
#PBS -l select=1:ncpus=12:mem=32gb
#PBS -l walltime=48:00:00
#PBS -j oe
#PBS -N PauliEntropy

set -eo pipefail
cd "${PBS_O_WORKDIR:?Submit from the repository root with qsub}"

pauli_venv="${PAULI_VENV:-${HOME}/myenv}"
pauli_python="$pauli_venv/bin/python"
if [[ ! -x "$pauli_python" ]]; then
    printf 'Pauli virtual environment interpreter is unavailable on %s: %s\n' "${HOSTNAME:-this node}" "$pauli_python" >&2
    exit 1
fi

if [[ -r /app1/ebenv && -r /etc/profile.d/rec_modules.sh ]]; then
    source /app1/ebenv Python-3.10.4
else
    printf 'Python module initialization is unavailable on %s. Using the existing Pauli virtual environment.\n' "${HOSTNAME:-this node}" >&2

    # The module normally supplies the shared-library directory for this Python.
    # A venv may contain either a symlink or a copy of the base interpreter.
    pauli_python_home=
    if [[ -r "$pauli_venv/pyvenv.cfg" ]]; then
        pauli_python_home=$(sed -n 's/^home[[:space:]]*=[[:space:]]*//p' "$pauli_venv/pyvenv.cfg")
    fi
    pauli_real_python=$(readlink -f -- "$pauli_python")
    for pauli_bin in "$pauli_python_home" "${pauli_real_python%/*}"; do
        [[ -n "$pauli_bin" ]] || continue
        pauli_prefix=$(dirname -- "${pauli_bin%/}")
        for pauli_lib in "$pauli_prefix/lib" "$pauli_prefix/lib64"; do
            if [[ -r "$pauli_lib/libpython3.10.so.1.0" ]]; then
                export LD_LIBRARY_PATH="$pauli_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
                printf 'Using Python shared libraries from %s\n' "$pauli_lib" >&2
                break 2
            fi
        done
    done
fi
unset PYTHONPATH

export MOSEKLM_LICENSE_FILE="${MOSEKLM_LICENSE_FILE:-${HOME}/mosek/mosek.lic}"
export PAULI_MOSEK_THREADS="${PAULI_MOSEK_THREADS:-${NCPUS:-12}}"
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

if [[ -n "${PAULI_MAX_N:-}" ]]; then
    counts=(--min-n "${PAULI_MIN_N:-1}" --max-n "$PAULI_MAX_N")
else
    counts=(--n 250 500 750 1000)
fi

if [[ -n "${PAULI_P:-}" ]]; then
    counts+=(--p "$PAULI_P")
fi
if [[ -n "${PAULI_COLLISION_EPSILON:-}" ]]; then
    counts+=(--collision-epsilon "$PAULI_COLLISION_EPSILON")
fi

exec "$pauli_python" -u run_cluster.py "${counts[@]}" --calculations collision --solver MOSEK --tol 1e-5
