#!/bin/bash
#PBS -P Entropy
#PBS -q parallel
#PBS -l select=1:ncpus=12:mem=32gb
#PBS -l walltime=48:00:00
#PBS -j oe
#PBS -N PauliEntropy

set -eo pipefail
cd "${PBS_O_WORKDIR:?Submit from the repository root with qsub}"

if [[ -r /app1/ebenv && -r /etc/profile.d/rec_modules.sh ]]; then
    source /app1/ebenv Python-3.10.4
else
    printf 'Python module initialization is unavailable on %s. Using the existing Pauli virtual environment.\n' "${HOSTNAME:-this node}" >&2
fi
unset PYTHONPATH

pauli_python="${PAULI_VENV:-${HOME}/myenv}/bin/python"
if [[ ! -x "$pauli_python" ]]; then
    printf 'Pauli virtual environment interpreter is unavailable on %s: %s\n' "${HOSTNAME:-this node}" "$pauli_python" >&2
    exit 1
fi

export MOSEKLM_LICENSE_FILE="${MOSEKLM_LICENSE_FILE:-${HOME}/mosek/mosek.lic}"
export PAULI_MOSEK_THREADS="${PAULI_MOSEK_THREADS:-${NCPUS:-12}}"
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

if [[ -n "${PAULI_MAX_N:-}" ]]; then
    counts=(--min-n "${PAULI_MIN_N:-1}" --max-n "$PAULI_MAX_N")
else
    counts=(--n 250 500 750 1000)
fi

if [[ -n "${PAULI_P:-}" ]]; then
    counts+=(--p "$PAULI_P")
fi
if [[ -n "${PAULI_COLLISION_EPSILON:-}" ]]; then
    counts+=(--collision-epsilon "$PAULI_COLLISION_EPSILON")
fi

exec "$pauli_python" -u run_cluster.py "${counts[@]}"
